@page "/error"
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<div class="narrow">
    <div class="card">
        <h1>Something went wrong</h1>
        <p class="muted">An unexpected error occurred while processing your request.</p>
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="small muted">Request ID: <code>@Model.RequestId</code></p>
        }
        <a class="btn" href="~/">Back to overview</a>
    </div>
</div>
