@page
@model Nullify.CalDav.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="narrow">
    <div class="card">
        <h1>Sign in</h1>
        <p class="muted">Manage your calendars, task lists, notes and contacts.</p>
        <partial name="_ValidationSummary" />

        @if (Model.Settings.OidcConfigured)
        {
            <a class="btn primary block" asp-page="/Account/Sso" asp-route-returnUrl="@Model.ReturnUrl">@Model.Settings.OidcButtonLabel</a>
            @if (Model.ShowLocal)
            {
                <div class="divider">or sign in with a password</div>
            }
        }

        @if (Model.ShowLocal)
        {
            <form method="post" class="stack">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="field">
                    <label asp-for="Username">Username or email</label>
                    <input asp-for="Username" autocomplete="username" autofocus />
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="current-password" />
                </div>
                <button class="@(Model.Settings.OidcConfigured ? "" : "primary") block" type="submit">Sign in</button>
            </form>
        }
    </div>
</div>
