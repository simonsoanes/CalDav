@page
@model Nullify.CalDav.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Profile";
}
<div class="page-head">
    <div>
        <h1>Profile</h1>
        <p>Signed in as <b>@Model.Me.Username</b>@(Model.Me.IsAdmin ? " (administrator)" : "")</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.NewToken))
{
    <div class="card">
        <h2>Your new app password</h2>
        <p class="muted">Use this together with your username <code>@Model.Me.Username</code> in your CalDAV/CardDAV client.</p>
        <div class="secret">@Model.NewToken</div>
    </div>
}

<div class="grid">
    <div class="card">
        <h2>Details</h2>
        <form method="post" asp-page-handler="Profile" class="stack">
            <div class="field">
                <label asp-for="DisplayName"></label>
                <input asp-for="DisplayName" />
            </div>
            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" />
                <span class="hint">Used as your calendar user address for invitations.</span>
            </div>
            <div><button class="primary" type="submit">Save</button></div>
        </form>
    </div>

    @if (Model.Me.AuthSource == AuthSource.Imap)
    {
        <div class="card">
            <h2>Password</h2>
            <p>Your password is verified by your mail server (<code>@(Model.ImapServer ?? "not configured")</code>) using the login <code>@Model.ImapLoginName</code>.</p>
            <p class="muted">Change it with your email provider. Signing in here and in CalDAV/CardDAV/SyncML clients uses the same password as your mailbox.</p>
        </div>
    }
    else
    {
    <div class="card">
        <h2>@(Model.Me.PasswordHash == null ? "Set a password" : "Change password")</h2>
        <form method="post" asp-page-handler="Password" class="stack">
            @if (Model.Me.PasswordHash != null)
            {
                <div class="field">
                    <label asp-for="CurrentPassword"></label>
                    <input asp-for="CurrentPassword" autocomplete="current-password" />
                </div>
            }
            <div class="field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" autocomplete="new-password" />
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
            </div>
            <div><button class="primary" type="submit">Update password</button></div>
        </form>
    </div>
    }
</div>

<div class="grid" style="margin-top:1.25rem">
    <div class="card">
        <h2>Calendar delegates</h2>
        <p class="muted">Delegates see (or manage) all of your calendars in their own apps, for example an assistant or partner.
            DAVx⁵ and Apple Calendar pick them up automatically.</p>
        @foreach (var d in Model.Delegates)
        {
            <form method="post" asp-page-handler="RemoveDelegate" asp-route-id="@d.Id" class="row" style="justify-content:space-between;margin:.4rem 0">
                <span>@d.Delegate.DisplayName <span class="muted small">@(d.CanWrite ? "read & write" : "read only")</span></span>
                <button class="small danger" type="submit">Remove</button>
            </form>
        }
        @if (Model.OtherUsers.Count > 0)
        {
            <form method="post" asp-page-handler="AddDelegate" class="row" style="margin-top:.75rem">
                <div class="field">
                    <label asp-for="DelegateUser"></label>
                    <select asp-for="DelegateUser">
                        @foreach (var u in Model.OtherUsers) { <option value="@u.Username">@u.DisplayName (@u.Username)</option> }
                    </select>
                </div>
                <label class="check"><input asp-for="DelegateCanWrite" /> Can edit</label>
                <button type="submit">Add</button>
            </form>
        }
    </div>
    <div class="card">
        <h2>Storage</h2>
        <p>Using <b>@ProfileModel.FormatBytes(Model.UsedBytes)</b>@(Model.QuotaBytes is { } q ? $" of {ProfileModel.FormatBytes(q)}" : "")</p>
        @if (Model.QuotaBytes is { } limit && limit > 0)
        {
            <div style="height:8px;background:var(--surface-2);border-radius:4px;overflow:hidden">
                <div style="height:100%;width:@(Math.Min(100, Model.UsedBytes * 100 / limit))%;background:var(--accent)"></div>
            </div>
        }
        <p class="small muted" style="margin-top:.75rem">Deleted items are kept in the <a asp-page="/Trash">trash</a> and do not count towards your quota.</p>
    </div>
</div>

<div class="grid" style="margin-top:1.25rem">
    <div class="card">
        <h2>Apple devices</h2>
        <p class="muted">Download a configuration profile that adds your calendars and contacts@(Model.Settings.ImapConfigured && !string.IsNullOrEmpty(Model.Me.Email) ? " and mail" : "") to iPhone, iPad or Mac. You will be asked for your password when installing it.</p>
        <a class="btn" asp-page-handler="AppleProfile">Download .mobileconfig</a>
    </div>
    <div class="card">
        <h2>SyncML</h2>
        @if (Model.Settings.SyncMlEnabled)
        {
            <p class="muted">For phones and apps that sync over SyncML (e.g. older Nokia/Sony Ericsson phones, Funambol clients).</p>
            <dl class="kv small">
                <dt>Server URL</dt><dd><code>@Model.SyncMlUrl</code></dd>
                <dt>Contacts</dt><dd><code>contacts</code></dd>
                <dt>Calendar</dt><dd><code>calendar</code> (events &amp; tasks), <code>events</code>, <code>tasks</code></dd>
                <dt>Notes</dt><dd><code>notes</code></dd>
            </dl>
            <p class="hint small muted">Append <code>/&lt;collection&gt;</code> to target a specific calendar or address book, e.g. <code>calendar/work</code>.</p>
        }
        else
        {
            <p class="muted">SyncML is disabled on this server.</p>
        }
    </div>
</div>

@if (Model.Devices.Count > 0)
{
    <div class="card" style="margin-top:1.25rem">
        <h2>SyncML devices</h2>
        <table>
            <thead><tr><th>Device</th><th>Model</th><th>Last sync</th><th></th></tr></thead>
            <tbody>
            @foreach (var d in Model.Devices)
            {
                <tr>
                    <td class="mono small">@d.DeviceId</td>
                    <td>@(string.Join(' ', new[] { d.Manufacturer, d.Model }.Where(x => !string.IsNullOrEmpty(x))))</td>
                    <td class="muted">@d.LastSyncUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td class="actions">
                        <form method="post" asp-page-handler="ForgetDevice" asp-route-id="@d.Id" onsubmit="return confirm('Forget this device? Its next sync will be a full (slow) sync.')">
                            <button class="small danger" type="submit">Forget</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

<div class="card" style="margin-top:1.25rem">
    <h2>App passwords</h2>
    <p class="muted">
        Create a separate password for each device or app that syncs with this server. They can be revoked individually.
        @if (Model.Settings.AllowAccountPasswordForDav)
        {
            <span>Your account password also works for CalDAV/CardDAV clients.</span>
        }
        else
        {
            <span>An app password is required for CalDAV/CardDAV clients.</span>
        }
    </p>
    @if (Model.AppPasswords.Count > 0)
    {
        <table>
            <thead><tr><th>Name</th><th>Created</th><th>Last used</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in Model.AppPasswords)
            {
                <tr>
                    <td>@a.Name</td>
                    <td class="muted">@a.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                    <td class="muted">@(a.LastUsedUtc?.ToString("yyyy-MM-dd HH:mm") + (a.LastUsedUtc == null ? "Never" : " UTC"))</td>
                    <td class="actions">
                        <form method="post" asp-page-handler="RevokeToken" asp-route-id="@a.Id" onsubmit="return confirm('Revoke this app password?')">
                            <button class="small danger" type="submit">Revoke</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    <form method="post" asp-page-handler="CreateToken" class="row" style="margin-top:1rem">
        <div class="field">
            <label asp-for="TokenName"></label>
            <input asp-for="TokenName" placeholder="e.g. Phone, Thunderbird" />
        </div>
        <button class="primary" type="submit">Create app password</button>
    </form>
</div>

@if (Model.Settings.OidcConfigured)
{
    <div class="card">
        <h2>Single sign-on</h2>
        @if (Model.Me.ExternalSubject != null)
        {
            <p>Your account is linked to an identity at your SSO provider.</p>
            <form method="post" asp-page-handler="Unlink"><button class="danger" type="submit">Unlink</button></form>
        }
        else
        {
            <p class="muted">Link your account so you can sign in with single sign-on.</p>
            <form method="post" asp-page="/Account/Sso" asp-page-handler="Link"><button type="submit">Link SSO account</button></form>
        }
    </div>
}
